+static inline uint32_t rd16(const uint8_t *p) { return p[0] | (uint32_t)p[1] << 8; }
+
+static void put_rgba(uint8_t *d, int r, int g, int b, int a) { d[0] = (uint8_t)r; d[1] = (uint8_t)g; d[2] = (uint8_t)b; d[3] = (uint8_t)a; }
+
+// BC1 colour block. four=1 forces the 4-colour mode (BC2/BC3 colour halves).
+static void bc1_color(const uint8_t *s, uint8_t *dst, size_t stride, int four, int with_alpha) {
+    uint32_t c0 = rd16(s), c1 = rd16(s + 2), bits = s[4] | s[5] << 8 | s[6] << 16 | (uint32_t)s[7] << 24;
+    int p[4][4];
+    uint32_t e[2] = {c0, c1};
+    for (int i = 0; i < 2; i++) {
+        int r = e[i] >> 11, g = (e[i] >> 5) & 63, b = e[i] & 31;
+        p[i][0] = r << 3 | r >> 2; p[i][1] = g << 2 | g >> 4; p[i][2] = b << 3 | b >> 2; p[i][3] = 255;
+    }
+    if (four || c0 > c1) {
+        for (int k = 0; k < 3; k++) { p[2][k] = (2 * p[0][k] + p[1][k]) / 3; p[3][k] = (p[0][k] + 2 * p[1][k]) / 3; }
+        p[2][3] = p[3][3] = 255;
+    } else {
+        for (int k = 0; k < 3; k++) { p[2][k] = (p[0][k] + p[1][k]) / 2; p[3][k] = 0; }
+        p[2][3] = 255; p[3][3] = 0;
+    }
+    for (int i = 0; i < 16; i++) {
+        int idx = (bits >> (2 * i)) & 3; uint8_t *d = dst + (i >> 2) * stride + (i & 3) * 4;
+        d[0] = (uint8_t)p[idx][0]; d[1] = (uint8_t)p[idx][1]; d[2] = (uint8_t)p[idx][2];
+        if (with_alpha) d[3] = (uint8_t)p[idx][3];
+    }
+}
+
+// BC4 single channel block into a strided plane (step = bytes between texels).
+static void bc4_plane(const uint8_t *s, uint8_t *dst, size_t stride, size_t step) {
+    int a0 = s[0], a1 = s[1], v[8];
+    v[0] = a0; v[1] = a1;
+    if (a0 > a1) for (int i = 1; i < 7; i++) v[i + 1] = ((7 - i) * a0 + i * a1) / 7;
+    else { for (int i = 1; i < 5; i++) v[i + 1] = ((5 - i) * a0 + i * a1) / 5; v[6] = 0; v[7] = 255; }
+    uint64_t bits = 0;
+    for (int i = 0; i < 6; i++) bits |= (uint64_t)s[2 + i] << (8 * i);
+    for (int i = 0; i < 16; i++) dst[(i >> 2) * stride + (i & 3) * step] = (uint8_t)v[(bits >> (3 * i)) & 7];
+}
+
+// Signed BC4 plane: endpoints are int8, results int8 in [-127, 127] (-128 reads as -1.0 like -127)
+static void bc4s_plane(const uint8_t *s, uint8_t *dst, size_t stride, size_t step) {
+    int a0 = (int8_t)s[0], a1 = (int8_t)s[1], v[8];
+    if (a0 < -127) a0 = -127;
+    if (a1 < -127) a1 = -127;
+    v[0] = a0; v[1] = a1;
+    #define RDIV(n, d) ((n) >= 0 ? ((n) + (d) / 2) / (d) : -(((-(n)) + (d) / 2) / (d)))
+    if (a0 > a1) for (int i = 1; i < 7; i++) { int n = (7 - i) * a0 + i * a1; v[i + 1] = RDIV(n, 7); }
+    else { for (int i = 1; i < 5; i++) { int n = (5 - i) * a0 + i * a1; v[i + 1] = RDIV(n, 5); } v[6] = -127; v[7] = 127; }
+    #undef RDIV
+    uint64_t bits = 0;
+    for (int i = 0; i < 6; i++) bits |= (uint64_t)s[2 + i] << (8 * i);
+    for (int i = 0; i < 16; i++) dst[(i >> 2) * stride + (i & 3) * step] = (uint8_t)(int8_t)v[(bits >> (3 * i)) & 7];
+}
+
+// BC7
+static const uint8_t bc7_mode[8][9] = {  // ns, pb, rb, isb, cb, ab, epb, spb, ib
+    {3, 4, 0, 0, 4, 0, 1, 0, 3}, {2, 6, 0, 0, 6, 0, 0, 1, 3}, {3, 6, 0, 0, 5, 0, 0, 0, 2}, {2, 6, 0, 0, 7, 0, 1, 0, 2},
+    {1, 0, 2, 1, 5, 6, 0, 0, 2}, {1, 0, 2, 0, 7, 8, 0, 0, 2}, {1, 0, 0, 0, 7, 7, 1, 0, 4}, {2, 6, 0, 0, 5, 5, 1, 0, 2}};
+static const uint8_t bc7_w2[4] = {0, 21, 43, 64}, bc7_w3[8] = {0, 9, 18, 27, 37, 46, 55, 64},
+                     bc7_w4[16] = {0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64};
+
+typedef struct { const uint8_t *p; int pos; } bitrd;
+static uint32_t bits(bitrd *b, int n) {
+    uint32_t v = 0;
+    for (int i = 0; i < n; i++, b->pos++) v |= (uint32_t)((b->p[b->pos >> 3] >> (b->pos & 7)) & 1) << i;
+    return v;
+}
+static int bc7_weight(int ib, int i) { return ib == 2 ? bc7_w2[i] : ib == 3 ? bc7_w3[i] : bc7_w4[i]; }
+static int lerp(int a, int b, int w) { return (a * (64 - w) + b * w + 32) >> 6; }
+
+static void bc7_block(const uint8_t *s, uint8_t *dst, size_t stride) {
+    int mode = 0;
+    while (mode < 8 && !((s[0] >> mode) & 1)) mode++;
+    if (mode == 8) { for (int y = 0; y < 4; y++) memset(dst + y * stride, 0, 16); return; }  // reserved: transparent black
+    const uint8_t *m = bc7_mode[mode];
+    int ns = m[0], pb = m[1], rb = m[2], isb = m[3], cb = m[4], ab = m[5], epb = m[6], spb = m[7], ib = m[8];
+    bitrd b = {s, mode + 1};
+    int part = (int)bits(&b, pb), rot = (int)bits(&b, rb), idxmode = (int)bits(&b, isb);
+    int ep[6][2][4];  // subset, endpoint, rgba
+    for (int c = 0; c < 3; c++) for (int i = 0; i < ns * 2; i++) ep[i >> 1][i & 1][c] = (int)bits(&b, cb);
+    for (int i = 0; i < ns * 2; i++) ep[i >> 1][i & 1][3] = ab ? (int)bits(&b, ab) : 255;
+    int pbit[6][2] = {{0}};
+    if (epb) for (int i = 0; i < ns * 2; i++) pbit[i >> 1][i & 1] = (int)bits(&b, 1);
+    else if (spb) for (int i = 0; i < ns; i++) pbit[i][0] = pbit[i][1] = (int)bits(&b, 1);
+    int has_p = epb || spb;
+    for (int i = 0; i < ns * 2; i++) for (int c = 0; c < 4; c++) {
+        int nb = c < 3 ? cb : ab; if (!nb) continue;
+        int v = ep[i >> 1][i & 1][c];
+        if (has_p) { v = v << 1 | pbit[i >> 1][i & 1]; nb++; }
+        ep[i >> 1][i & 1][c] = v << (8 - nb) | v >> (2 * nb - 8);
+    }
+    uint32_t pm = ns == 1 ? 0 : ns == 2 ? bc7_part2[part] : bc7_part3[part];
+    int anc[3] = {0, ns == 2 ? bc7_anchor2[part] : bc7_anchor3a[part], bc7_anchor3b[part]};
+    int sub[16], isanchor[16];
+    for (int i = 0; i < 16; i++) { sub[i] = (pm >> (2 * i)) & 3; isanchor[i] = i == anc[sub[i]]; }
+    int ib2 = mode == 4 ? 3 : mode == 5 ? 2 : 0, idx[16], idx2[16];
+    for (int i = 0; i < 16; i++) idx[i] = (int)bits(&b, isanchor[i] ? ib - 1 : ib);
+    if (ib2) for (int i = 0; i < 16; i++) idx2[i] = (int)bits(&b, i == 0 ? ib2 - 1 : ib2);
+    for (int i = 0; i < 16; i++) {
+        int *e0 = ep[sub[i]][0], *e1 = ep[sub[i]][1], px[4];
+        int cbits = ib, abits = ib, ci = idx[i], ai = idx[i];
+        if (ib2) {
+            if (mode == 4 && idxmode) { cbits = ib2; ci = idx2[i]; abits = ib; ai = idx[i]; }
+            else { abits = ib2; ai = idx2[i]; }
+        }
+        int wc = bc7_weight(cbits, ci), wa = bc7_weight(abits, ai);
+        for (int c = 0; c < 3; c++) px[c] = lerp(e0[c], e1[c], wc);
+        px[3] = lerp(e0[3], e1[3], wa);
+        if (rot) { int t = px[3]; px[3] = px[rot - 1]; px[rot - 1] = t; }
+        put_rgba(dst + (i >> 2) * stride + (i & 3) * 4, px[0], px[1], px[2], px[3]);
+    }
+}
+
+void bcd_decode_block(bcd_fmt f, const uint8_t *s, uint8_t *dst, size_t stride) {
+    switch (f) {
+    case BCD_1: bc1_color(s, dst, stride, 0, 1); break;
+    case BCD_2:
+        bc1_color(s + 8, dst, stride, 1, 0);
+        for (int i = 0; i < 16; i++) { int a = (s[i >> 1] >> ((i & 1) * 4)) & 15; dst[(i >> 2) * stride + (i & 3) * 4 + 3] = (uint8_t)(a << 4 | a); }
+        break;
+    case BCD_3: bc1_color(s + 8, dst, stride, 1, 0); bc4_plane(s, dst + 3, stride, 4); break;
+    case BCD_4U: bc4_plane(s, dst, stride, 1); break;
+    case BCD_5U: bc4_plane(s, dst, stride, 2); bc4_plane(s + 8, dst + 1, stride, 2); break;
+    case BCD_7: bc7_block(s, dst, stride); break;
+    case BCD_6U: bcd_bc6h_block(s, dst, stride, 0); break;
+    case BCD_6S: bcd_bc6h_block(s, dst, stride, 1); break;
+    case BCD_4S: bc4s_plane(s, dst, stride, 1); break;
+    case BCD_5S: bc4s_plane(s, dst, stride, 2); bc4s_plane(s + 8, dst + 1, stride, 2); break;
+    }
+}
+
+void bcd_decode_image(bcd_fmt f, const uint8_t *src, uint32_t w, uint32_t h, uint8_t *dst, size_t stride) {
+    int bb = bcd_block_bytes(f), bpp = bcd_out_bpp(f);
+    uint32_t bw = (w + 3) / 4, bh = (h + 3) / 4;
+    uint8_t tmp[4 * 4 * 8];
+    for (uint32_t by = 0; by < bh; by++) for (uint32_t bx = 0; bx < bw; bx++) {
+        const uint8_t *s = src + ((size_t)by * bw + bx) * bb;
+        uint32_t cw = w - bx * 4 < 4 ? w - bx * 4 : 4, ch = h - by * 4 < 4 ? h - by * 4 : 4;
+        if (cw == 4 && ch == 4) { bcd_decode_block(f, s, dst + (size_t)by * 4 * stride + (size_t)bx * 4 * bpp, stride); continue; }
+        bcd_decode_block(f, s, tmp, 4 * bpp);
+        for (uint32_t y = 0; y < ch; y++) memcpy(dst + ((size_t)by * 4 + y) * stride + (size_t)bx * 4 * bpp, tmp + y * 4 * bpp, (size_t)cw * bpp);
+    }
+}
diff --git a/dm/gfx/tex/bc_decode.h b/dm/gfx/tex/bc_decode.h
new file mode 100644
index 0000000..1b10cde
--- /dev/null
+++ b/dm/gfx/tex/bc_decode.h
@@ -0,0 +1,20 @@
+// bc_decode.h: CPU decoder for BC1-BC5 and BC7 blocks, for GPUs without BC texture support (A14 and older).
+#ifndef BCD_DECODE_H
+#define BCD_DECODE_H
+#include <stddef.h>
+#include <stdint.h>
+
+typedef enum { BCD_1, BCD_2, BCD_3, BCD_4U, BCD_5U, BCD_7, BCD_4S, BCD_5S, BCD_6U, BCD_6S } bcd_fmt;   // 4S / 5S output signed bytes (R8Snorm / RG8Snorm); 6U / 6S (BC6H) output RGBA16F
+
+// Bytes per 4x4 block of the compressed data.
+static inline int bcd_block_bytes(bcd_fmt f) { return f == BCD_1 || f == BCD_4U || f == BCD_4S ? 8 : 16; }
+// Bytes per texel of the decoded output: BC4 -> R8, BC5 -> RG8, BC6H -> RGBA16F, the rest -> RGBA8.
+static inline int bcd_out_bpp(bcd_fmt f) { return f == BCD_4U || f == BCD_4S ? 1 : f == BCD_5U || f == BCD_5S ? 2 : f == BCD_6U || f == BCD_6S ? 8 : 4; }
+
+void bcd_bc6h_block(const uint8_t *src, uint8_t *dst, size_t stride, int is_signed);   // bc6h_decode.c
+// Decodes one block into a 4x4 texel window of dst (row stride in bytes).
+void bcd_decode_block(bcd_fmt f, const uint8_t *src, uint8_t *dst, size_t stride);
+// Decodes a w x h level (blocks row-major, tightly packed) into dst; edge blocks are clipped.
+void bcd_decode_image(bcd_fmt f, const uint8_t *src, uint32_t w, uint32_t h, uint8_t *dst, size_t stride);
+
+#endif
diff --git a/dm/gfx/tex/tests/bcdump.c b/dm/gfx/tex/tests/bcdump.c
new file mode 100644
index 0000000..a100dbf
--- /dev/null
+++ b/dm/gfx/tex/tests/bcdump.c
@@ -0,0 +1,15 @@
+// bcdump FMT W H < blocks > rgba : decodes a raw BC level for comparison against a reference decoder.
+#include "../bc_decode.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+int main(int c, char **v) {
+    bcd_fmt f = !strcmp(v[1], "bc1") ? BCD_1 : !strcmp(v[1], "bc2") ? BCD_2 : !strcmp(v[1], "bc3") ? BCD_3 : !strcmp(v[1], "bc4") ? BCD_4U : !strcmp(v[1], "bc5") ? BCD_5U : !strcmp(v[1], "bc5s") ? BCD_5S : !strcmp(v[1], "bc4s") ? BCD_4S : !strcmp(v[1], "bc6h") ? BCD_6U : !strcmp(v[1], "bc6hs") ? BCD_6S : BCD_7;
+    unsigned w = atoi(v[2]), h = atoi(v[3]);
+    size_t n = (size_t)((w + 3) / 4) * ((h + 3) / 4) * bcd_block_bytes(f), o = (size_t)w * h * bcd_out_bpp(f);
+    uint8_t *in = malloc(n), *out = malloc(o);
+    if (fread(in, 1, n, stdin) != n) return 1;
+    bcd_decode_image(f, in, w, h, out, (size_t)w * bcd_out_bpp(f));
+    fwrite(out, 1, o, stdout);
+    return 0;
+}
diff --git a/dm/gfx/tex/tests/cmp.py b/dm/gfx/tex/tests/cmp.py
new file mode 100644
index 0000000..5e993d6
--- /dev/null
+++ b/dm/gfx/tex/tests/cmp.py
@@ -0,0 +1,33 @@
+import os, subprocess, struct, io, sys
+import numpy as np
+from PIL import Image
+from ref import FMT
+def refdec(fmt, data, w, h):
+    dxgi = FMT[fmt][0]
+    hdr = b'DDS ' + struct.pack('<7I', 124, 0x1007|0x80000, h, w, 0, 0, 1) + b'\0'*44
+    hdr += struct.pack('<2I4s5I', 32, 4, b'DX10', 0,0,0,0,0) + struct.pack('<5I', 0x1000,0,0,0,0)
+    hdr += struct.pack('<5I', dxgi, 3, 0, 1, 0)
+    im = Image.open(io.BytesIO(hdr+data)); im.load()
+    return im
+if __name__!="__main__": raise SystemExit
+bb = {'bc1':8,'bc2':16,'bc3':16,'bc4':8,'bc5':16,'bc7':16}
+for fmt in bb:
+    worst=0; bad=0; tot=0
+    for (w,h) in [(64,64),(30,18),(4,4),(7,5)]:
+        n=((w+3)//4)*((h+3)//4)
+        for seed in range(20 if (w,h)==(64,64) else 5):
+            rng=np.random.default_rng(seed*7+w)
+            d=bytearray(rng.integers(0,256,n*bb[fmt],dtype=np.uint8).tobytes())
+            if fmt=='bc7':
+                for i in range(n):
+                    if d[i*16]==0: d[i*16]=1<<(i%8)
+            out=subprocess.run(['./bcdump',fmt,str(w),str(h)],input=bytes(d),capture_output=True).stdout
+            im=refdec({'bc4':'bc4','bc5':'bc5'}.get(fmt,fmt),bytes(d),w,h)
+            ref=np.array(im)
+            ch={'bc4':1,'bc5':2}.get(fmt,4)
+            mine=np.frombuffer(out,dtype=np.uint8).reshape(h,w,ch)
+            if ref.ndim==2: ref=ref[:,:,None]
+            if fmt=='bc5': ref=ref[:,:,:2]
+            if ref.shape[2]==3 and ch==4: ref=np.concatenate([ref,np.full((h,w,1),255,np.uint8)],2)
+            df=np.abs(mine.astype(int)-ref.astype(int)); worst=max(worst,df.max()); bad+=(df>1).any(axis=2).sum(); tot+=w*h
+    print(fmt,'max diff',worst,'texels off by >1:',bad,'of',tot)
diff --git a/dm/gfx/tex/tests/gentables.py b/dm/gfx/tex/tests/gentables.py
new file mode 100644
index 0000000..5f79247
--- /dev/null
+++ b/dm/gfx/tex/tests/gentables.py
@@ -0,0 +1,56 @@
+from ref import decode
+class BW:
+    def __init__(s): s.v=0; s.n=0
+    def put(s, val, nb): s.v |= (val & ((1<<nb)-1)) << s.n; s.n += nb
+    def bytes(s): return s.v.to_bytes(16,'little')
+def px(im):  # 16 pixels in raster order
+    return [im.getpixel((i%4,i//4)) for i in range(16)]
+def mode1(part, eps, idxbits1=True):
+    b=BW(); b.put(0b10,2); b.put(part,6)
+    for ch in range(3):
+        for e in range(4): b.put(eps[e][ch],6)
+    b.put(0,2)
+    b.put((1<<46)-1 if idxbits1 else 0, 46)
+    assert b.n==128; return b.bytes()
+def mode0(part, eps, idx=True):
+    b=BW(); b.put(0b100,3); b.put(part,6)
+    for ch in range(3):
+        for e in range(6): b.put(eps[e][ch],5)
+    b.put((1<<29)-1 if idx else 0, 29)
+    assert b.n==128; return b.bytes()
+part2=[];anch2=[];part3=[];anch3a=[];anch3b=[]
+Z=(0,0,0);W=(63,63,63)
+for p in range(64):
+    # membership: subset1 bright, indices 0
+    pr=px(decode('bc7',mode1(p,[Z,Z,W,W],False),4,4))
+    part2.append([1 if q[0]>128 else 0 for q in pr])
+    # anchor of subset1: ep2=Z ep3=W, all index bits one -> non-anchors white, anchor grey
+    pr=px(decode('bc7',mode1(p,[Z,Z,Z,W],True),4,4))
+    mem=part2[-1]
+    cand=[i for i in range(16) if mem[i]==1 and pr[i][0]<200]
+    assert len(cand)==1,(p,cand); anch2.append(cand[0])
+R=(31,0,0);G=(0,31,0)
+for p in range(64):
+    pr=px(decode('bc7',mode0(p,[Z,Z,R,R,G,G],False),4,4))
+    m=[]
+    for q in pr:
+        m.append(1 if q[0]>128 else (2 if q[1]>128 else 0))
+    part3.append(m)
+    for sub,(eps,ch,lst) in {1:([Z,Z,R,Z,Z,Z],0,anch3a),2:([Z,Z,Z,Z,G,Z],1,anch3b)}.items():
+        pass
+    # anchor sub1: ep2 =Z, ep3=R(15) ; anchor sub2: ep4=Z, ep5=G
+    pr=px(decode('bc7',mode0(p,[Z,Z,Z,R,Z,Z],True),4,4))
+    c=[i for i in range(16) if m[i]==1 and pr[i][0]<200]; assert len(c)==1,(p,c,'a'); anch3a.append(c[0])
+    pr=px(decode('bc7',mode0(p,[Z,Z,Z,Z,Z,G],True),4,4))
+    c=[i for i in range(16) if m[i]==2 and pr[i][1]<200]; assert len(c)==1,(p,c,'b'); anch3b.append(c[0])
+def mask(rows): return [sum(v<<i for i,v in enumerate(r)) for r in rows]
+def mask3(rows): return [sum(v<<(2*i) for i,v in enumerate(r)) for r in rows]
+with open('bc7_tables.inc','w') as f:
+    f.write('// Generated by gentables.py from a reference decoder; do not edit by hand.\n')
+    f.write('// Subset of each of the 16 texels: 2 bits per texel, texel 0 in the lowest bits.\n')
+    f.write('static const uint32_t bc7_part2[64] = {'+','.join('0x%08x'%v for v in mask3(part2))+'};\n')
+    f.write('static const uint32_t bc7_part3[64] = {'+','.join('0x%08x'%v for v in mask3(part3))+'};\n')
+    f.write('static const uint8_t bc7_anchor2[64] = {'+','.join(map(str,anch2))+'};\n')
+    f.write('static const uint8_t bc7_anchor3a[64] = {'+','.join(map(str,anch3a))+'};\n')
+    f.write('static const uint8_t bc7_anchor3b[64] = {'+','.join(map(str,anch3b))+'};\n')
+print(anch2[:20]); print(part2[:2])
