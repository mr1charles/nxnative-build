+    for (id<MTLAllocation> o in g_res_objects.allObjects) { if (![(id)o conformsToProtocol:@protocol(MTLTexture)]) continue; id<MTLTexture> t = o;
+        unsigned rt = (t.usage & MTLTextureUsageRenderTarget) ? 1 : 0; uint64_t key = ((uint64_t)t.pixelFormat << 48) ^ ((uint64_t)t.width << 32) ^ ((uint64_t)t.height << 16) ^ ((uint64_t)t.mipmapLevelCount << 8) ^ rt ^ ((uint64_t)t.arrayLength << 56);
+        int i = 0; while (i < ng && g[i].key != key) i++; if (i == ng) { if (ng == G) continue; ng++; g[i].key = key; g[i].w = (unsigned)t.width; g[i].h = (unsigned)t.height; g[i].l = (unsigned)t.mipmapLevelCount; g[i].pf = (unsigned)t.pixelFormat; g[i].rt = rt; }
+        g[i].n++; g[i].mb += t.allocatedSize; }
+    pthread_mutex_unlock(&g_res_mu);
+    for (int k = 0; k < 16; k++) { int b = -1; uint64_t bm = 0; for (int i = 0; i < ng; i++) if (g[i].n && g[i].mb > bm) { bm = g[i].mb; b = i; }
+        if (b < 0) break; MLOG("%s: texture group %ux%u pf %u levels %u%s x%u = %llu MB", why, g[b].w, g[b].h, g[b].pf, g[b].l, g[b].rt ? " rendertarget" : "", g[b].n, (unsigned long long)(g[b].mb >> 20)); g[b].n = 0; }
+} }
