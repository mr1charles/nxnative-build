@@ -5628,7 +5628,17 @@ static void *tex_mtl_resolve(const tex_t *ct, int *in_storage, id<MTLTexture> __
 // Purpose: pin down "crashes with no log". The system gives no notice before killing a process for memory, so only readouts left beforehand can show which number kept climbing.
 // Called by the frame hook every 300 frames; printed only when resident or GPU allocated changed by ≥ 64 MB since the last line, otherwise one line every 3000 frames; capped at 400 lines per game. All integers (the frame hook runs on the guest thread's small stack, so no floating-point formatting)
 static _Atomic uint64_t g_gptr_bindings, g_gptr_reads, g_gptr_added, g_gptr_bytes;   // gmem_discover: bindings with sources, readable words, newly addressed logical pool/run ranges and bytes
+// DM_MEM_TOP: what the GPU holds (res_top), with each memory line and at each jump of 128 MB or more in GPU allocated within 250 ms (watched from a thread): a texture or buffer burst that takes the phone past its limit
+static void mem_watch_start(void) {
+    static int on; if (on++ || !getenv("DM_MEM_TOP")) return;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        uint64_t last = g_dev.currentAllocatedSize; int n = 0;
+        for (;;) { usleep(250000); uint64_t now = g_dev.currentAllocatedSize;
+            if (now > last + (128ull << 20) && n < 24) { n++; MLOG("memory jump: GPU allocated %llu -> %llu MB", (unsigned long long)(last >> 20), (unsigned long long)(now >> 20)); res_top("memory jump"); }
+            last = now; } });
+}
 void mtl_mem_stat(unsigned long long frame, unsigned long long rss_mb) {
+    mem_watch_start();
     static unsigned long long last_rss, last_gpu, last_frame; static int lines; unsigned long long gpu = (unsigned long long)(g_dev.currentAllocatedSize >> 20);
     unsigned long long dr = rss_mb > last_rss ? rss_mb - last_rss : last_rss - rss_mb, dg = gpu > last_gpu ? gpu - last_gpu : last_gpu - gpu;
     if (lines >= 400 || (lines && dr < 64 && dg < 64 && frame - last_frame < 3000)) return; lines++; last_rss = rss_mb; last_gpu = gpu; last_frame = frame;
@@ -5649,6 +5659,7 @@ void mtl_mem_stat(unsigned long long frame, unsigned long long rss_mb) {
 #endif
