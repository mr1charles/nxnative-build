+// DM_MEM_TOP: the residency set's textures grouped by format, size, levels and usage: the count and megabytes of each of the 16 groups that take most
+static void res_hist(const char *why) { @autoreleasepool {
+    enum { G = 512 }; static struct { uint64_t key; unsigned n; uint64_t mb; unsigned w, h, l, pf, rt; } g[G]; int ng = 0; memset(g, 0, sizeof g);
